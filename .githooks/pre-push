#!/bin/sh
#
# AnimePv-promt - protected branch guard
#
# RED LINE: direct pushes to main are forbidden. Push to dev and open a PR.
#
# Enable (repo-local, already committed):
#   git config core.hooksPath .githooks
#
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>

PROTECTED="main master"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Skip branch deletions (local_sha all zeros)
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac

    branch=$(printf '%s' "$remote_ref" | sed 's#^refs/heads/##')

    for p in $PROTECTED; do
        if [ "$branch" = "$p" ]; then
            blocked=1
            echo "" >&2
            echo "BLOCKED: direct push to protected branch '$p' is not allowed." >&2
            echo "" >&2
            echo "  ref: $remote_ref" >&2
            echo "" >&2
            echo "  Push to dev instead:" >&2
            echo "    git push origin HEAD:dev" >&2
            echo "" >&2
            echo "  Then open a pull request dev -> $p." >&2
            echo "" >&2
        fi
    done
done

if [ "$blocked" -ne 0 ]; then
    echo "pre-push hook rejected this push." >&2
    exit 1
fi

exit 0